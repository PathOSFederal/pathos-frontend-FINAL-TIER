# PathOS live frontend/backend local integration example values.
# Copy this file to .env.local and restart the Next.js server after changes.

# Local backend base URL for the frontend proxy routes.
PATHOS_BACKEND_BASE_URL=http://127.0.0.1:8000

# Backend API key used by the frontend proxy routes for live Job Search and
# Saved Jobs evaluation. This must match a key accepted by the backend
# PATHOS_API_KEYS configuration.
PATHOS_BACKEND_API_KEY=replace-with-your-local-backend-api-key
